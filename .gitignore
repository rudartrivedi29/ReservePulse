# ==============================================================================
# ReservePulse - Secure Production Git Ignore Rules
# ==============================================================================

# Environment & Secret Variables (NEVER commit live secrets)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Credentials & Keys
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519
*.token
*.pfx

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build & Production Artifacts
dist/
backend/dist/
frontend/dist/
build/
out/
.next/

# Application & Execution Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE & Operating System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Testing, Telemetry & Coverage
coverage/
.nyc_output/

# Cache & Temporary Run Data
.turbo/
.cache/
.temp/
tmp/
scratch/
