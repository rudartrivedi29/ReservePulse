{
  "name": "reservepulse",
  "version": "0.1.0",
  "private": true,
  "description": "ReservePulse - Resilient Multi-tier Reservation & Resource Orchestration Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "typecheck": "npm run typecheck --prefix backend && npm run build --prefix frontend",
    "test": "npm run test:audit --prefix backend",
    "test:audit": "npm run test:audit --prefix backend",
    "test:concurrency": "npm run test:concurrency --prefix backend",
    "test:questions": "npm run test:questions --prefix backend",
    "test:payment": "npm run test:payment --prefix backend",
    "test:organiser": "npm run test:organiser --prefix backend",
    "test:admin": "npm run test:admin --prefix backend",
    "test:analytics": "npm run test:analytics --prefix backend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "start": "npm run start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
